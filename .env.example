NODE_ENV=development
HOST=127.0.0.1
PORT=4000
# Local SQLite file, used when DATABASE_URL is empty.
DATABASE_PATH=.data/mr-connect.sqlite
UPLOAD_DIR=.data/uploads
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4000,http://127.0.0.1:4000
# Production: use HTTPS, NODE_ENV=production, a private writable data volume and no demo data.

# PostgreSQL. Leave empty to use the SQLite file above.
# Use a direct (non-pooled) URL when DATABASE_SCHEMA is set; a pooled URL works without a schema.
DATABASE_URL=
DATABASE_SCHEMA=
DATABASE_POOL=10
